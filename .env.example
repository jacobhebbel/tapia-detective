# Copy this file to .env and fill in your real key. .env is git-ignored.

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: override the default model used for character agents.
# Any OpenRouter model slug works, e.g. anthropic/claude-3.5-sonnet, openai/gpt-4o-mini
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
